<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.LoginPage" BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}">
    <Grid x:Name="LoginRoot" ColumnDefinitions="1.15*,*" Padding="70">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Phone">
                    <VisualState.StateTriggers><StateTrigger IsActive="True"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="False"/>
                        <Setter TargetName="LoginCard" Property="Grid.Column" Value="0"/>
                        <Setter TargetName="LoginCard" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="LoginCard" Property="Margin" Value="8"/>
                        <Setter TargetName="LoginCard" Property="Padding" Value="20"/>
                        <Setter TargetName="LoginCard" Property="MaximumWidthRequest" Value="640"/>
                        <Setter TargetName="LoginRoot" Property="Padding" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="True"/>
                        <Setter TargetName="LoginCard" Property="Grid.Column" Value="1"/>
                        <Setter TargetName="LoginCard" Property="Grid.ColumnSpan" Value="1"/>
                        <Setter TargetName="LoginCard" Property="Margin" Value="0"/>
                        <Setter TargetName="LoginCard" Property="Padding" Value="38"/>
                        <Setter TargetName="LoginRoot" Property="Padding" Value="70"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <VerticalStackLayout x:Name="BrandPanel" VerticalOptions="Center" Spacing="18" Margin="20">
                    <HorizontalStackLayout Spacing="8">
                        <mi:MauiIcon Icon="{mi:Material Icon=AccountBalanceWallet}" IconSize="40" IconColor="{StaticResource BlingPrimary}" WidthRequest="46" HeightRequest="46"/>
                        <Label Text="MONEY PRO" TextColor="{StaticResource BlingPrimary}" FontSize="28" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
            <Label Text="Clareza para decidir.&#10;Controle para realizar." TextColor="{StaticResource BlingPrimary}" FontSize="40" FontAttributes="Bold"/>
            <Label Text="Seu patrimônio, orçamento e rotina financeira protegidos em um banco local." TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="16" WidthRequest="470" HorizontalOptions="Start"/>
            <HorizontalStackLayout Spacing="22" Margin="0,20,0,0">
                <Label Text="Dados locais" TextColor="{StaticResource BlingPrimary}"/>
                <Label Text="Senha protegida" TextColor="{StaticResource BlingPrimary}"/>
                <Label Text="Sem anúncios" TextColor="{StaticResource BlingPrimary}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <Border x:Name="LoginCard" Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" Padding="38"
                MaximumWidthRequest="600" VerticalOptions="Center">
            <VerticalStackLayout Spacing="16">
                <Label Text="Bem-vindo" TextColor="{StaticResource BlingPrimary}" FontSize="28" FontAttributes="Bold"/>
                <Label Text="Entre para acessar suas finanças" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                <Label Text="Email" Style="{StaticResource CardCaption}" Margin="0,10,0,0"/>
                <Border Style="{StaticResource InputContainer}"><Entry x:Name="EmailEntry" Placeholder="voce@email.com" Keyboard="Email" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
                <Label Text="Senha" Style="{StaticResource CardCaption}"/>
                <Border Style="{StaticResource InputContainer}" Padding="12,0,4,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Entry x:Name="PasswordEntry" Placeholder="Sua senha" IsPassword="True"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/>
                        <Button x:Name="PasswordVisibilityButton" Grid.Column="1" Text="Mostrar"
                                BackgroundColor="Transparent" TextColor="{StaticResource BlingPrimary}"
                                BorderWidth="0" Padding="8,0" HeightRequest="44"
                                FontSize="12" FontAttributes="Bold"
                                Clicked="OnTogglePasswordClicked"/>
                    </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                    <Border Style="{StaticResource SelectionControlContainer}"><HorizontalStackLayout>
                        <CheckBox x:Name="RememberCheck"/>
                        <Label Text="Lembrar-me" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                    </HorizontalStackLayout></Border>
                    <Button Grid.Column="1" Text="Esqueci a senha" Style="{StaticResource TextButton}" Clicked="OnForgotClicked" ImageSource="{icons:MaterialIconSource Icon=LockReset, ColorResource=BlingPrimary, IconSize=20}"/>
                </Grid>
                <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" IsVisible="False"/>
                <Button Text="Entrar" Style="{StaticResource PrimaryButton}" Clicked="OnLoginClicked" ImageSource="{icons:MaterialIconSource Icon=AccountCircle, ColorResource=BlingTextLight, IconSize=20}"/>
                <Button Text="Criar uma conta" BackgroundColor="Transparent" TextColor="{StaticResource BlingPrimary}" Clicked="OnRegisterClicked" ImageSource="{icons:MaterialIconSource Icon=PersonAdd, ColorResource=BlingPrimary, IconSize=20}"/>
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0" Padding="12">
                    <Label Text="Demonstração: demo@money.local  •  Money123" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11" HorizontalTextAlignment="Center"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
