<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             x:Class="Money.TransactionEditPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" Padding="18,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                             WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="12" Aspect="AspectFit" 
                             Clicked="OnCancelClicked"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="TitleLabel" Text="Editar lançamento" TextColor="{StaticResource BlingTextLight}"
                           FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Atualize os dados e salve" TextColor="{StaticResource BlingTextLight}" FontSize="12"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Fill">
                <Border Style="{StaticResource ContentCard}">
                    <VerticalStackLayout Spacing="16">

                        <!-- Descrição -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Descrição" Style="{StaticResource CardCaption}" 
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Padding="12,2" HeightRequest="50">
                                <Entry x:Name="DescriptionEntry" Placeholder="Ex: Supermercado" 
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"
                                       IsEnabled="True" IsReadOnly="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Valor e Data -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Valor" Style="{StaticResource CardCaption}" 
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2"
                                        StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                        Padding="12,2" HeightRequest="50">
                                    <Entry x:Name="AmountEntry" Keyboard="Numeric" Placeholder="R$ 0,00" 
                                           BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"
                                           IsEnabled="True" IsReadOnly="False"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Data" Style="{StaticResource CardCaption}" 
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                                <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2"
                                        StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                        Padding="4,2" HeightRequest="50">
                                    <Grid>
                                        <Button x:Name="TransactionDateButton" BackgroundColor="Transparent"
                                                TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold"
                                                HorizontalOptions="Fill" BorderWidth="0"
                                                Clicked="OnTransactionDateClicked"/>
                                        <DatePicker x:Name="TransactionDatePicker" IsVisible="False"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Categoria -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Categoria" Style="{StaticResource CardCaption}" 
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                            <Border Stroke="{StaticResource BlingPrimary}" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Padding="4,2" HeightRequest="52">
                                <Grid>
                                    <Button x:Name="CategorySelectionButton" Text="Selecione a categoria"
                                            BackgroundColor="Transparent" TextColor="{StaticResource BlingPrimary}"
                                            FontAttributes="Bold" HorizontalOptions="Fill" BorderWidth="0"
                                            Clicked="OnSelectCategoryClicked"/>
                                    <Picker x:Name="CategoryPicker" IsVisible="False" InputTransparent="True"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SupplierPanel" Spacing="6">
                            <Label Text="Fornecedor (opcional)" Style="{StaticResource CardCaption}" FontAttributes="Bold"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="4,2">
                                <Grid>
                                    <Button x:Name="SupplierSelectionButton" Text="Nenhum fornecedor"
                                            ImageSource="{icons:MaterialIconSource Icon=Store, ColorResource=BlingPrimary, IconSize=20}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource BlingPrimary}"
                                            BorderWidth="0" HorizontalOptions="Fill" Clicked="OnSelectSupplierClicked"/>
                                    <Picker x:Name="SupplierPicker" IsVisible="False" InputTransparent="True"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Origem igual ao cadastro de despesas -->
                        <VerticalStackLayout x:Name="SourcePanel" Spacing="6">
                            <Label Text="Origem / Destino" Style="{StaticResource CardCaption}" FontAttributes="Bold"/>
                            <Button x:Name="SourceTypeSelectionButton" Text="Conta bancária"
                                    ImageSource="{icons:MaterialIconSource Icon=SwapHoriz, ColorResource=BlingPrimary, IconSize=20}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    TextColor="{StaticResource BlingPrimary}" BorderWidth="1"
                                    BorderColor="{StaticResource BlingPrimary}" Clicked="OnSelectSourceTypeClicked"/>
                            <Picker x:Name="SourceTypePicker" IsVisible="False" SelectedIndexChanged="OnSourceTypeChanged"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="AccountPanel" Spacing="6">
                            <Label Text="Conta" Style="{StaticResource CardCaption}" FontAttributes="Bold"/>
                            <Button x:Name="AccountSelectionButton" Text="Selecione a conta"
                                    ImageSource="{icons:MaterialIconSource Icon=AccountBalanceWallet, ColorResource=BlingPrimary, IconSize=20}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    TextColor="{StaticResource BlingPrimary}" Clicked="OnSelectAccountClicked"/>
                            <Picker x:Name="AccountPicker" IsVisible="False"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="CardPanel" IsVisible="False" Spacing="6">
                            <Label Text="Cartão de crédito" Style="{StaticResource CardCaption}" FontAttributes="Bold"/>
                            <Button x:Name="CardSelectionButton" Text="Selecione o cartão"
                                    ImageSource="{icons:MaterialIconSource Icon=CreditCard, ColorResource=BlingPrimary, IconSize=20}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    TextColor="{StaticResource BlingPrimary}" Clicked="OnSelectCardClicked"/>
                            <Picker x:Name="CardPicker" IsVisible="False"/>
                        </VerticalStackLayout>

                        <!-- Observações -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Observações" Style="{StaticResource CardCaption}" 
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Padding="12,8" HeightRequest="96">
                                <Editor x:Name="NotesEditor" Placeholder="Detalhes adicionais..." 
                                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                        IsEnabled="True" IsReadOnly="False"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Data de Vencimento -->
                        <VerticalStackLayout x:Name="DueDatePanel" Spacing="6">
                            <Label Text="Data de vencimento" Style="{StaticResource CardCaption}" 
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Padding="4,2" HeightRequest="50">
                                <Grid>
                                    <Button x:Name="DueDateButton" BackgroundColor="Transparent"
                                            TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold"
                                            HorizontalOptions="Fill" BorderWidth="0"
                                            Clicked="OnDueDateClicked"/>
                                    <DatePicker x:Name="DueDatePicker" IsVisible="False"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Border x:Name="PaymentStatusCard" Style="{StaticResource SelectionControlContainer}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="Conta paga" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                        <Label Text="Atualiza o saldo da conta ao salvar" FontSize="10" Style="{StaticResource CardCaption}"/>
                                    </VerticalStackLayout>
                                    <Switch x:Name="PaidSwitch" Grid.Column="1" OnColor="{StaticResource BlingPrimary}"
                                            Toggled="OnPaidToggled"/>
                                </Grid>
                                <Border x:Name="PaymentDateBorder" IsVisible="False" Style="{StaticResource InputContainer}">
                                    <DatePicker x:Name="PaymentDatePicker" Format="dd/MM/yyyy"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Parcelamento -->
                        <Border x:Name="InstallmentCard" Style="{StaticResource SelectionControlContainer}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="Parcelado" FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                        <Label x:Name="InstallmentHintLabel" Text="Dividir esta despesa em parcelas mensais" FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/>
                                    </VerticalStackLayout>
                                    <Switch x:Name="InstallmentSwitch" Grid.Column="1" OnColor="{StaticResource BlingPrimary}"
                                            Toggled="OnInstallmentToggled"/>
                                </Grid>
                                <Grid x:Name="InstallmentPanel" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Número de parcelas" Style="{StaticResource CardCaption}"/>
                                        <Border Style="{StaticResource InputContainer}" Padding="4">
                                            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="4">
                                                <Button Text="−" WidthRequest="44" HeightRequest="44" Padding="0"
                                                        FontSize="22" FontAttributes="Bold" CornerRadius="10"
                                                        BackgroundColor="{StaticResource BlingPrimary}"
                                                        TextColor="{StaticResource BlingTextLight}"
                                                        Clicked="OnDecreaseInstallmentsClicked"/>
                                                <Label x:Name="InstallmentCountLabel" Grid.Column="1" Text="2 parcelas"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                       TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold"/>
                                                <Button Grid.Column="2" Text="+" WidthRequest="44" HeightRequest="44" Padding="0"
                                                        FontSize="22" FontAttributes="Bold" CornerRadius="10"
                                                        BackgroundColor="{StaticResource BlingPrimary}"
                                                        TextColor="{StaticResource BlingTextLight}"
                                                        Clicked="OnIncreaseInstallmentsClicked"/>
                                                <Stepper x:Name="InstallmentStepper" IsVisible="False" Minimum="2" Maximum="36"
                                                         Value="2" ValueChanged="OnInstallmentCountChanged"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Primeira parcela" Style="{StaticResource CardCaption}"/>
                                        <Border Style="{StaticResource InputContainer}">
                                            <DatePicker x:Name="FirstInstallmentDatePicker" Format="dd/MM/yyyy"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Lançamento Recorrente -->
                        <Border Style="{StaticResource SelectionControlContainer}"><Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Text="Lançamento recorrente" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   FontSize="15" VerticalTextAlignment="Center"/>
                            <Switch x:Name="RecurringSwitch" Grid.Column="1" 
                                    OnColor="{StaticResource BlingPrimary}" ThumbColor="{StaticResource BlingPrimary}"
                                    Toggled="OnRecurringToggled">
                                <Switch.Triggers>
                                    <Trigger TargetType="Switch" Property="IsToggled" Value="True">
                                        <Setter Property="ThumbColor" Value="{StaticResource BlingTextLight}"/>
                                    </Trigger>
                                </Switch.Triggers>
                            </Switch>
                        </Grid></Border>

                        <!-- Frequência (oculto por padrão) -->
                        <Border x:Name="FrequencyBorder" IsVisible="False"
                                Stroke="{StaticResource BlingPrimary}" StrokeThickness="2"
                                StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                Padding="4,2" HeightRequest="52">
                            <Grid>
                                <Button x:Name="FrequencySelectionButton" Text="Selecione a frequência"
                                        BackgroundColor="Transparent" TextColor="{StaticResource BlingPrimary}"
                                        FontAttributes="Bold" HorizontalOptions="Fill" BorderWidth="0"
                                        Clicked="OnSelectFrequencyClicked"/>
                                <Picker x:Name="FrequencyPicker" IsVisible="False" InputTransparent="True"/>
                            </Grid>
                        </Border>

                        <!-- Tags -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tags" Style="{StaticResource CardCaption}" 
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold"/>
                            <FlexLayout x:Name="TagsContainer" Wrap="Wrap" Direction="Row"/>
                        </VerticalStackLayout>

                        <!-- Mensagem de erro -->
                        <Label x:Name="ErrorLabel" IsVisible="False" 
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rodapé -->
        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" Padding="16,14">
            <Grid ColumnDefinitions="*,1.5*" ColumnSpacing="12" MaximumWidthRequest="720" HorizontalOptions="Fill">
                <Button Text="Cancelar" ImageSource="{icons:MaterialIconSource Icon=Close, ColorResource=BlingTextLight, IconSize=20}" 
                        BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                        FontAttributes="Bold" HeightRequest="50" CornerRadius="12" 
                        Clicked="OnCancelClicked"/>
                <Button Grid.Column="1" Text="Salvar alterações" ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" 
                        BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}" 
                        FontAttributes="Bold" HeightRequest="50" CornerRadius="12"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>

