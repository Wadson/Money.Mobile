<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.RegisterPage" 
             Title="Criar conta" 
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Header com Gradiente -->
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" 
                Padding="20,16" HeightRequest="120">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <mi:MauiIcon Icon="{mi:Material Icon=PersonAdd}" IconSize="38" IconColor="{StaticResource BlingPrimary}" WidthRequest="44" HeightRequest="44"/>
                    <Label Text="MONEY PRO" TextColor="{StaticResource BlingTextLight}" FontSize="26" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
                <Label Text="Sua jornada financeira começa aqui" TextColor="{StaticResource BlingTextLight}" FontSize="14" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Conteúdo do Formulário -->
        <ScrollView Grid.Row="0" Margin="0,80,0,0">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                    StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    Padding="20,28,20,32"
                    Margin="8,0,8,20"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="16">

                    <!-- Título -->
                    <Label Text="Criar sua conta" TextColor="{StaticResource BlingPrimary}" FontSize="24" FontAttributes="Bold"/>
                    <Label Text="Preencha os dados abaixo para começar" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Margin="0,4,0,4"/>

                    <!-- Nome -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome completo" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="NameEntry" Placeholder="Digite seu nome completo"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="E-mail" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="EmailEntry" Placeholder="seu@email.com" Keyboard="Email"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Senha -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Senha" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="PasswordEntry" Placeholder="Mínimo 8 caracteres" IsPassword="True"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirmar Senha -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Confirmar senha" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="ConfirmationEntry" Placeholder="Digite a senha novamente" IsPassword="True"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Data de Nascimento -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Data de nascimento" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <DatePicker x:Name="BirthDatePicker" Format="dd/MM/yyyy" Date="01/01/1990"
                                        FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                        VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Margin="0,4,0,4"/>

                    <!-- Pergunta de Recuperação -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Pergunta de segurança" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Button x:Name="RecoveryQuestionButton" Text="Selecione uma pergunta"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                    BorderWidth="0" HorizontalOptions="Fill" HeightRequest="44"
                                    Clicked="OnSelectRecoveryQuestionClicked"/>
                            <Picker x:Name="RecoveryQuestionPicker" Title="Selecione uma pergunta" IsVisible="False"
                                    FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                    TitleColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Cidade onde nasceu?</x:String>
                                    <x:String>Nome do seu primeiro animal?</x:String>
                                    <x:String>Primeiro nome da sua mãe?</x:String>
                                    <x:String>Nome da sua escola de infância?</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Resposta de Segurança -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Resposta de segurança" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="RecoveryAnswerEntry" Placeholder="Digite sua resposta"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Termos -->
                    <Border Style="{StaticResource SelectionControlContainer}" Margin="0,4,0,0"><HorizontalStackLayout Spacing="8">
                        <CheckBox x:Name="TermsCheck" VerticalOptions="Center"/>
                        <Label Text="Li e aceito os" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>
                        <Label Text="Termos de uso" TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold" VerticalTextAlignment="Center" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="e a" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>
                        <Label Text="Política de privacidade" TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold" VerticalTextAlignment="Center" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout></Border>

                    <!-- Erro -->
                    <Label x:Name="ErrorLabel" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" IsVisible="False" Padding="8,4"/>

                    <!-- Botões -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="Voltar" ImageSource="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=20}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                CornerRadius="10" HeightRequest="48"
                                Clicked="OnCancelClicked"/>
                        <Button Grid.Column="1" Text="Criar conta" ImageSource="{icons:MaterialIconSource Icon=PersonAdd, ColorResource=BlingTextLight, IconSize=20}"
                                BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="10" HeightRequest="48"
                                FontAttributes="Bold"
                                Clicked="OnSubmitClicked"/>
                    </Grid>

                    <!-- Link para Login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                        <Label Text="Já tem uma conta?" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>
                        <Label Text="Faça login" TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
