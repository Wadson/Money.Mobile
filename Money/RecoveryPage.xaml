<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.RecoveryPage" 
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" 
             Title="Recuperar senha"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Header com Gradiente -->
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" 
                Padding="20,16" HeightRequest="120">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <mi:MauiIcon Icon="{mi:Material Icon=LockReset}" IconSize="38" IconColor="{StaticResource BlingPrimary}" WidthRequest="44" HeightRequest="44"/>
                    <Label Text="MONEY PRO" TextColor="{StaticResource BlingTextLight}" FontSize="26" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
                <Label Text="Recupere sua senha com segurança" TextColor="{StaticResource BlingTextLight}" FontSize="14" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Conteúdo do Formulário -->
        <ScrollView Grid.Row="0" Margin="0,80,0,0">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                    StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    Padding="20,28,20,32"
                    Margin="8,0,8,20"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="16">

                    <!-- Título -->
                    <Label Text="Recuperar senha" TextColor="{StaticResource BlingPrimary}" FontSize="24" FontAttributes="Bold"/>
                    <Label Text="Confirme seus dados para redefinir sua senha" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Margin="0,4,0,4"/>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="E-mail cadastrado" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EmailEntry" Placeholder="seu@email.com" Keyboard="Email"
                               FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
                    </VerticalStackLayout>

                    <!-- Data de Nascimento -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Data de nascimento" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                        <Border Style="{StaticResource InputContainer}"><DatePicker x:Name="BirthDatePicker" Format="dd/MM/yyyy" Date="01/01/1990"
                                    FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/></Border>
                    </VerticalStackLayout>

                    <!-- Botão Verificar -->
                    <Button x:Name="VerifyButton" Text="Verificar identidade" ImageSource="{icons:MaterialIconSource Icon=PersonSearch, ColorResource=BlingTextLight, IconSize=20}"
                            BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                            CornerRadius="10" HeightRequest="48"
                            FontAttributes="Bold"
                            Clicked="OnVerifyClicked"/>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Margin="0,8,0,8"/>

                    <!-- Painel de Reset (visível após verificação) -->
                    <VerticalStackLayout x:Name="ResetPanel" IsVisible="False" Spacing="14">

                        <!-- Pergunta de Segurança -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Pergunta de segurança" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11" FontAttributes="Bold"/>
                                <Label x:Name="QuestionLabel" Text="Cidade onde nasceu?" 
                                       TextColor="{StaticResource BlingPrimary}" FontSize="14" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Resposta -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Sua resposta" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                            <Border Style="{StaticResource InputContainer}"><Entry x:Name="AnswerEntry" Placeholder="Digite sua resposta"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
                        </VerticalStackLayout>

                        <!-- Nova Senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nova senha" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                            <Border Style="{StaticResource InputContainer}"><Entry x:Name="NewPasswordEntry" Placeholder="Mínimo 8 caracteres" IsPassword="True"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
                        </VerticalStackLayout>

                        <!-- Confirmar Senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Confirmar nova senha" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                            <Border Style="{StaticResource InputContainer}"><Entry x:Name="ConfirmationEntry" Placeholder="Digite a nova senha novamente" IsPassword="True"
                                   FontSize="14" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
                        </VerticalStackLayout>

                        <!-- Botão Alterar -->
                        <Button Text="Alterar senha" ImageSource="{icons:MaterialIconSource Icon=LockReset, ColorResource=BlingTextLight, IconSize=20}"
                                BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="10" HeightRequest="48"
                                FontAttributes="Bold"
                                Clicked="OnResetClicked"/>
                    </VerticalStackLayout>

                    <!-- Mensagem de Feedback -->
                    <Label x:Name="MessageLabel" IsVisible="False" FontSize="12" Padding="8,4"/>

                    <!-- Links Inferiores -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Text="Voltar" ImageSource="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=20}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                CornerRadius="10" HeightRequest="44"
                                Clicked="OnCancelClicked"/>
                        <Button Grid.Column="1" Text="Login" ImageSource="{icons:MaterialIconSource Icon=AccountCircle, ColorResource=BlingTextLight, IconSize=20}"
                                BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="10" HeightRequest="44"
                                FontAttributes="Bold"
                                Clicked="OnLoginClicked"/>
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,0">
                        <Label Text="Lembrou sua senha?" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>
                        <Label Text="Faça login" TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold" FontSize="13">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
