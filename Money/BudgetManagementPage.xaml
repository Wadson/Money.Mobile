<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.BudgetManagementPage" 
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" 
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Cabeçalho Principal -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                             WidthRequest="44" HeightRequest="44" 
                             Padding="10" CornerRadius="12" 
                             Aspect="AspectFit" 
                             Clicked="OnBackClicked"
                             VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=Savings}" IconSize="22" IconColor="{StaticResource BlingTextLight}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Text="Orçamentos" TextColor="{StaticResource BlingTextLight}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Limites mensais por categoria" TextColor="{StaticResource BlingTextLight}" FontSize="11"/>
                </VerticalStackLayout>

                <ImageButton Grid.Column="2" 
                             Source="{icons:MaterialIconSource Icon=Add, ColorResource=BlingTextLight, IconSize=24}" 
                             BackgroundColor="{StaticResource BlingPrimary}" 
                             WidthRequest="44" HeightRequest="44" 
                             Padding="10" CornerRadius="12" 
                             Aspect="AspectFit"
                             Clicked="OnNewClicked"
                             VerticalOptions="Center"
                             AutomationProperties.Name="Novo orçamento"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,40" Spacing="16"
                                 MaximumWidthRequest="1200" HorizontalOptions="Fill">

                <!-- Seletor de Mês / Período -->
                <Border Style="{StaticResource ContentCard}" Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">

                        <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                                     BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                     WidthRequest="44" HeightRequest="44" 
                                     Padding="10" CornerRadius="12" 
                                     Clicked="OnPreviousClicked"/>

                        <Label x:Name="PeriodLabel" Grid.Column="1" 
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{StaticResource BlingPrimary}" FontSize="15" FontAttributes="Bold"/>

                        <ImageButton Grid.Column="2" 
                                     Source="{icons:MaterialIconSource Icon=ArrowForward, ColorResource=BlingText, IconSize=24}" 
                                     BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                     WidthRequest="44" HeightRequest="44" 
                                     Padding="10" CornerRadius="12" 
                                     Clicked="OnNextClicked"/>
                    </Grid>
                </Border>

                <!-- Card de Formulário (Novo / Editar Orçamento) -->
                <Border x:Name="FormCard" IsVisible="False" Style="{StaticResource ContentCard}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="FormTitle" Text="Novo orçamento" Style="{StaticResource SectionTitle}"/>

                        <Border Style="{StaticResource InputContainer}"><Grid>
                            <Button x:Name="CategorySelectionButton" Text="Selecione a categoria" BackgroundColor="Transparent"
                                    TextColor="{StaticResource BlingPrimary}" BorderWidth="0" Clicked="OnSelectCategoryClicked"/>
                            <Picker x:Name="CategoryPicker" IsVisible="False"/>
                        </Grid></Border>

                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="LimitEntry" 
                               Placeholder="Limite mensal" 
                               Keyboard="Numeric" 
                               HeightRequest="46"
                               BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                               PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>

                        <Border Style="{StaticResource InputContainer}"><Editor x:Name="NotesEditor" 
                                Placeholder="Observações" 
                                AutoSize="TextChanges" 
                                MinimumHeightRequest="80"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button Text="Cancelar" 
                                    ImageSource="{icons:MaterialIconSource Icon=Close, ColorResource=BlingTextLight, IconSize=20}"
                                    BackgroundColor="{StaticResource BlingPrimary}" 
                                    TextColor="{StaticResource BlingTextLight}" 
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Clicked="OnCancelClicked"/>

                            <Button Grid.Column="1" 
                                    Text="Salvar orçamento" 
                                    ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    HeightRequest="44"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Clicked="OnSaveClicked"/>
                        </Grid>

                        <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11" Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Container Dinâmico da Lista de Orçamentos -->
                <VerticalStackLayout x:Name="BudgetsContainer" Spacing="12"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

