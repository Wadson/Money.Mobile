<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:local="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.OptionSelectionPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
             Shell.NavBarIsVisible="False">

    <Grid Padding="18" VerticalOptions="Center">

        <!-- Contêiner Principal Modal -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                StrokeThickness="0" 
                Padding="18"
                MaximumHeightRequest="620" 
                MaximumWidthRequest="900"
                StrokeShape="RoundRectangle 20"
                HorizontalOptions="Fill">

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">

                <!-- Cabeçalho do Modal -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" Padding="12,10">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="TitleLabel" Text="Selecione" TextColor="{StaticResource BlingTextLight}"
                               FontSize="20" FontAttributes="Bold"/>
                        <Label Text="Toque em uma opção para continuar" TextColor="{StaticResource BlingTextLight}" FontSize="11"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="" 
                            ImageSource="{icons:MaterialIconSource Icon=Close, ColorResource=BlingText, IconSize=20}" 
                            BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                            WidthRequest="40" HeightRequest="40" CornerRadius="20"
                            Clicked="OnCancelClicked" VerticalOptions="Start"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource InputContainer}" Padding="8,0">
                    <SearchBar x:Name="OptionSearchBar" Placeholder="Pesquisar..." HeightRequest="44"
                               BackgroundColor="Transparent"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                               TextChanged="OnSearchTextChanged"/>
                </Border>

                <!-- Lista de Opções -->
                <CollectionView x:Name="OptionsList" Grid.Row="2" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:SelectionOption">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" 
                                    StrokeThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,8" 
                                    StrokeShape="RoundRectangle 12">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOptionTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- Ícone da Opção -->
                                    <Border BackgroundColor="{Binding Background}" 
                                            StrokeThickness="0"
                                            HeightRequest="42" WidthRequest="42"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="Center" VerticalOptions="Center">

                                        <mi:MauiIcon Icon="{Binding ImageSource}" IconSize="26" IconColor="{Binding Foreground}" 
                                                     WidthRequest="32" HeightRequest="32" Opacity="0.8"
                                                     HorizontalOptions="Center" VerticalOptions="Center">
                                            <mi:MauiIcon.Triggers>
                                                <DataTrigger TargetType="mi:MauiIcon" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Scale" Value="1.10"/>
                                                </DataTrigger>
                                            </mi:MauiIcon.Triggers>
                                        </mi:MauiIcon>
                                    </Border>

                                    <!-- Rótulo da Opção -->
                                    <Label Grid.Column="1" Text="{Binding Label}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           FontSize="14" FontAttributes="Bold"
                                           VerticalTextAlignment="Center"/>

                                    <!-- Seletor próprio para não depender do contraste do RadioButton nativo. -->
                                    <Button Grid.Column="2"
                                            Text="○"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnSelectButtonClicked"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                            TextColor="{StaticResource BlingPrimary}"
                                            BorderColor="{StaticResource BlingPrimary}"
                                            BorderWidth="2"
                                            CornerRadius="22"
                                            Padding="0"
                                            FontSize="26"
                                            FontAttributes="Bold"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            AutomationProperties.Name="Selecionar opção">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource BlingPrimary}"/>
                                                <Setter Property="TextColor" Value="{StaticResource BlingTextLight}"/>
                                                <Setter Property="BorderColor" Value="{StaticResource BlingPrimary}"/>
                                                <Setter Property="Scale" Value="1.06"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Botão Rodapé -->
                <Button Grid.Row="3" Text="Cancelar" 
                        ImageSource="{icons:MaterialIconSource Icon=Close, ColorResource=BlingTextLight, IconSize=20}"
                        BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                        HeightRequest="48" CornerRadius="10" FontSize="14"
                        Clicked="OnCancelClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

