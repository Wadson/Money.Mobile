<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons" xmlns:icons="clr-namespace:Money"
 x:Class="Money.ProfilePage" BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" Title="Meu perfil">
 <ScrollView><VerticalStackLayout Padding="8,16" Spacing="14" MaximumWidthRequest="900" HorizontalOptions="Center">
  <Grid ColumnDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" Padding="16,12"><ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="12" Aspect="AspectFit" Clicked="OnCloseClicked"/><Label Grid.Column="1" Text="Meu perfil" TextColor="{StaticResource BlingTextLight}" FontSize="23" FontAttributes="Bold" VerticalTextAlignment="Center"/></Grid>
  <Border Style="{StaticResource ContentCard}"><VerticalStackLayout Spacing="12">
   <Label Text="Dados do usuário local" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource InputContainer}"><Entry x:Name="NameEntry" Placeholder="Nome completo" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border><Border Style="{StaticResource InputContainer}"><Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
   <Label Text="DATA DE NASCIMENTO" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><DatePicker x:Name="BirthPicker" Format="dd/MM/yyyy" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/></Border>
   <Label Text="PERGUNTA DE RECUPERAÇÃO" Style="{StaticResource CardCaption}"/>
   <Border Style="{StaticResource InputContainer}"><Picker x:Name="QuestionPicker" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" TitleColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"><Picker.Items><x:String>Cidade onde nasceu?</x:String><x:String>Nome do seu primeiro animal?</x:String><x:String>Primeiro nome da sua mãe?</x:String><x:String>Nome da sua escola de infância?</x:String></Picker.Items></Picker></Border>
   <Border Style="{StaticResource InputContainer}"><Entry x:Name="AnswerEntry" Placeholder="Nova resposta (deixe vazio para manter)" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/></Border>
   <Label x:Name="MessageLabel" IsVisible="False"/><Button Text="Salvar alterações" ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
