<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money.Helpers"
             xmlns:controls="clr-namespace:Money.Controls"
             x:Class="Money.Views.Auth.RecoveryPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Title="Recuperar senha"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- ========================================================= -->
        <!-- CABEÇALHO                                                 -->
        <!-- ========================================================= -->

        <Border BackgroundColor="{StaticResource BlingPrimary}"
                StrokeThickness="0"
                HeightRequest="108"
                VerticalOptions="Start"
                Padding="20,14">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="3">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="9">

                    <!-- ÍCONE RECUPERAÇÃO -->

                    <Image
                        Source="{icons:MaterialIconSource Icon=LockReset, ColorResource=BlingTextLight, IconSize=36}"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center"/>

                    <Label Text="MONEY"
                           TextColor="{StaticResource BlingTextLight}"
                           FontSize="27"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center"/>

                </HorizontalStackLayout>

                <Label Text="Recupere sua senha com segurança"
                       TextColor="{StaticResource BlingTextLight}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Border>


        <!-- ========================================================= -->
        <!-- CONTEÚDO                                                   -->
        <!-- ========================================================= -->

        <ScrollView Margin="0,82,0,0"
                    VerticalScrollBarVisibility="Never">

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18"
                    Margin="10,8,10,18"
                    MaximumWidthRequest="620"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="9">


                    <!-- ================================================= -->
                    <!-- TÍTULO                                             -->
                    <!-- ================================================= -->

                    <HorizontalStackLayout
                        Spacing="8"
                        Margin="0,0,0,0">

                        <Image
                            Source="{icons:MaterialIconSource Icon=LockReset, ColorResource=BlingPrimary, IconSize=25}"
                            WidthRequest="25"
                            HeightRequest="25"
                            VerticalOptions="Center"/>

                        <Label Text="Recuperar senha"
                               TextColor="{StaticResource BlingPrimary}"
                               FontSize="23"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center"/>

                    </HorizontalStackLayout>


                    <Label Text="Confirme seus dados para redefinir sua senha"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="13"
                           Margin="0,-2,0,3"/>


                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                             Margin="0,0,0,4"/>


                    <!-- ================================================= -->
                    <!-- USUÁRIO                                            -->
                    <!-- ================================================= -->

                    <Label Text="Usuário"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,0,0,-4"/>


                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE USUÁRIO -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Person, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>


                            <Entry x:Name="UserEntry"
                                   Grid.Column="1"
                                   Placeholder="Ex.: Wadson"
                                   Keyboard="Text"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- DATA DE NASCIMENTO                                -->
                    <!-- ================================================= -->

                    <Label Text="Data de nascimento"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>


                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE CALENDÁRIO -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=CalendarMonth, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>


                            <controls:ThemedDateSelector x:Name="BirthDatePicker"
                                        Grid.Column="1"
                                        Format="dd/MM/yyyy"
                                        Date="01/01/1990"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                        VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- VERIFICAR IDENTIDADE                              -->
                    <!-- ================================================= -->

                    <Button x:Name="VerifyButton"
                            Text="Verificar identidade"
                            ImageSource="{icons:MaterialIconSource Icon=PersonSearch, ColorResource=BlingTextLight, IconSize=20}"
                            BackgroundColor="{StaticResource BlingPrimary}"
                            TextColor="{StaticResource BlingTextLight}"
                            CornerRadius="11"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            FontSize="15"
                            Margin="0,3,0,2"
                            Clicked="OnVerifyClicked"/>


                    <!-- ================================================= -->
                    <!-- SEPARADOR                                          -->
                    <!-- ================================================= -->

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                             Margin="0,4,0,4"/>


                    <!-- ================================================= -->
                    <!-- PAINEL DE RESET                                    -->
                    <!-- ================================================= -->

                    <VerticalStackLayout x:Name="ResetPanel"
                                         IsVisible="False"
                                         Spacing="9">


                        <!-- ================================================= -->
                        <!-- PERGUNTA DE SEGURANÇA                            -->
                        <!-- ================================================= -->

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
                                Stroke="{StaticResource BlingPrimary}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">

                                <!-- ÍCONE SEGURANÇA -->

                                <Image
                                    Source="{icons:MaterialIconSource Icon=Security, ColorResource=BlingPrimary, IconSize=24}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    VerticalOptions="Start"/>


                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2">

                                    <Label Text="Pergunta de segurança"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           FontSize="11"
                                           FontAttributes="Bold"/>

                                    <Label x:Name="QuestionLabel"
                                           Text="Cidade onde nasceu?"
                                           TextColor="{StaticResource BlingPrimary}"
                                           FontSize="14"
                                           FontAttributes="Bold"/>

                                    <Label x:Name="HintLabel"
                                           Text=""
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/>

                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- RESPOSTA                                           -->
                        <!-- ================================================= -->

                        <Label Text="Palavra-chave / resposta de segurança"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,2,0,-4"/>


                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                Stroke="{StaticResource BlingPrimary}"
                                StrokeThickness="1.3"
                                StrokeShape="RoundRectangle 11"
                                Padding="10,0">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  HeightRequest="50">

                                <Image
                                    Source="{icons:MaterialIconSource Icon=Key, ColorResource=BlingPrimary, IconSize=21}"
                                    WidthRequest="21"
                                    HeightRequest="21"
                                    VerticalOptions="Center"/>

                                <Entry x:Name="AnswerEntry"
                                       Grid.Column="1"
                                       Placeholder="Digite sua palavra-chave"
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- NOVA SENHA                                         -->
                        <!-- ================================================= -->

                        <Label Text="Nova senha"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,2,0,-4"/>


                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                Stroke="{StaticResource BlingPrimary}"
                                StrokeThickness="1.3"
                                StrokeShape="RoundRectangle 11"
                                Padding="10,0">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  HeightRequest="50">

                                <Image
                                    Source="{icons:MaterialIconSource Icon=Lock, ColorResource=BlingPrimary, IconSize=21}"
                                    WidthRequest="21"
                                    HeightRequest="21"
                                    VerticalOptions="Center"/>

                                <Entry x:Name="NewPasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Mínimo 8 caracteres"
                                       IsPassword="True"
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- CONFIRMAR SENHA                                    -->
                        <!-- ================================================= -->

                        <Label Text="Confirmar nova senha"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,2,0,-4"/>


                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                Stroke="{StaticResource BlingPrimary}"
                                StrokeThickness="1.3"
                                StrokeShape="RoundRectangle 11"
                                Padding="10,0">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  HeightRequest="50">

                                <Image
                                    Source="{icons:MaterialIconSource Icon=Lock, ColorResource=BlingPrimary, IconSize=21}"
                                    WidthRequest="21"
                                    HeightRequest="21"
                                    VerticalOptions="Center"/>

                                <Entry x:Name="ConfirmationEntry"
                                       Grid.Column="1"
                                       Placeholder="Digite a nova senha novamente"
                                       IsPassword="True"
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- ALTERAR SENHA                                      -->
                        <!-- ================================================= -->

                        <Button x:Name="ResetButton"
                                Text="Alterar senha"
                                ImageSource="{icons:MaterialIconSource Icon=LockReset, ColorResource=BlingTextLight, IconSize=20}"
                                BackgroundColor="{StaticResource BlingPrimary}"
                                TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="11"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                FontSize="15"
                                Margin="0,3,0,1"
                                Clicked="OnResetClicked"/>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- MENSAGEM                                           -->
                    <!-- ================================================= -->

                    <Label x:Name="MessageLabel"
                           IsVisible="False"
                           FontSize="12"
                           Padding="8,4"
                           HorizontalTextAlignment="Center"/>


                    <!-- ================================================= -->
                    <!-- VOLTAR / LOGIN                                     -->
                    <!-- ================================================= -->

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          Margin="0,4,0,0">


                        <Button Text="Voltar"
                                ImageSource="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingTextDarkLight, IconSize=19}"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                                BorderWidth="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                CornerRadius="11"
                                HeightRequest="46"
                                FontSize="13"
                                Clicked="OnCancelClicked"/>


                        <Button Grid.Column="1"
                                Text="Login"
                                ImageSource="{icons:MaterialIconSource Icon=AccountCircle, ColorResource=BlingTextLight, IconSize=19}"
                                BackgroundColor="{StaticResource BlingPrimary}"
                                TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="11"
                                HeightRequest="46"
                                FontSize="13"
                                FontAttributes="Bold"
                                Clicked="OnLoginClicked"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- RODAPÉ                                             -->
                    <!-- ================================================= -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        Margin="0,3,0,0">

                        <Image
                            Source="{icons:MaterialIconSource Icon=Lock, ColorResource=BlingPrimary, IconSize=15}"
                            WidthRequest="15"
                            HeightRequest="15"
                            VerticalOptions="Center"/>

                        <Label Text="Lembrou sua senha?"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="12"
                               VerticalTextAlignment="Center"/>

                        <Label Text="Faça login"
                               TextColor="{StaticResource BlingPrimary}"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalTextAlignment="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </ScrollView>

    </Grid>

</ContentPage>
