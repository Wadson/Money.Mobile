<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money.Helpers"
             x:Class="Money.Views.Auth.RegisterPage"
             Title="Criar conta"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- ========================================================= -->
        <!-- CABEÇALHO                                                 -->
        <!-- ========================================================= -->

        <Border BackgroundColor="{StaticResource BlingPrimary}"
                StrokeThickness="0"
                HeightRequest="108"
                VerticalOptions="Start"
                Padding="20,14">

            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="3">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="9">

                    <!-- ÍCONE CRIAR CONTA -->

                    <Image
                        Source="{icons:MaterialIconSource Icon=PersonAdd, ColorResource=BlingTextLight, IconSize=36}"
                        WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Center"/>

                    <Label Text="MONEY"
                           TextColor="{StaticResource BlingTextLight}"
                           FontSize="27"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center"/>

                </HorizontalStackLayout>

                <Label Text="Sua jornada financeira começa aqui"
                       TextColor="{StaticResource BlingTextLight}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Border>


        <!-- ========================================================= -->
        <!-- CONTEÚDO                                                  -->
        <!-- ========================================================= -->

        <ScrollView Margin="0,82,0,0"
                    VerticalScrollBarVisibility="Never">

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18"
                    Margin="10,8,10,18"
                    MaximumWidthRequest="620"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="9">


                    <!-- ================================================= -->
                    <!-- TÍTULO                                             -->
                    <!-- ================================================= -->

                    <HorizontalStackLayout
                        Spacing="8">

                        <Image
                            Source="{icons:MaterialIconSource Icon=PersonAdd, ColorResource=BlingPrimary, IconSize=25}"
                            WidthRequest="25"
                            HeightRequest="25"
                            VerticalOptions="Center"/>

                        <Label Text="Criar sua conta"
                               TextColor="{StaticResource BlingPrimary}"
                               FontSize="23"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center"/>

                    </HorizontalStackLayout>

                    <Label Text="Preencha os dados abaixo para começar"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="13"
                           Margin="0,-2,0,3"/>


                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                             Margin="0,0,0,4"/>


                    <!-- ================================================= -->
                    <!-- NOME COMPLETO                                      -->
                    <!-- ================================================= -->

                    <Label Text="Nome completo"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,0,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE USUÁRIO -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Person, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Entry x:Name="NameEntry"
                                   Grid.Column="1"
                                   Placeholder="Digite seu nome completo"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- E-MAIL                                             -->
                    <!-- ================================================= -->

                    <Label Text="E-mail"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE E-MAIL -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Email, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Entry x:Name="EmailEntry"
                                   Grid.Column="1"
                                   Placeholder="seu@email.com"
                                   Keyboard="Email"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- SENHA                                              -->
                    <!-- ================================================= -->

                    <Label Text="Senha"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="7"
                              HeightRequest="50">

                            <!-- ÍCONE SENHA -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Lock, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Mínimo 8 caracteres"
                                   IsPassword="True"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                            <!-- BOTÃO MOSTRAR SENHA -->

                            <Button x:Name="PasswordVisibilityButton"
                                    Grid.Column="2"
                                    Text="👁"
                                    FontSize="17"
                                    Padding="6,0"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource BlingPrimary}"
                                    BorderWidth="0"
                                    HeightRequest="44"
                                    WidthRequest="42"
                                    SemanticProperties.Description="Mostrar senha"
                                    Clicked="OnTogglePasswordVisibilityClicked"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- CONFIRMAR SENHA                                    -->
                    <!-- ================================================= -->

                    <Label Text="Confirmar senha"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="7"
                              HeightRequest="50">

                            <!-- ÍCONE CONFIRMAÇÃO -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Lock, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Entry x:Name="ConfirmationEntry"
                                   Grid.Column="1"
                                   Placeholder="Digite a senha novamente"
                                   IsPassword="True"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                            <!-- BOTÃO MOSTRAR CONFIRMAÇÃO -->

                            <Button x:Name="ConfirmationVisibilityButton"
                                    Grid.Column="2"
                                    Text="👁"
                                    FontSize="17"
                                    Padding="6,0"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource BlingPrimary}"
                                    BorderWidth="0"
                                    HeightRequest="44"
                                    WidthRequest="42"
                                    SemanticProperties.Description="Mostrar confirmação da senha"
                                    Clicked="OnToggleConfirmationVisibilityClicked"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- DATA DE NASCIMENTO                                -->
                    <!-- ================================================= -->

                    <Label Text="Data de nascimento"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE CALENDÁRIO -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=CalendarMonth, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <DatePicker x:Name="BirthDatePicker"
                                        Grid.Column="1"
                                        Format="dd/MM/yyyy"
                                        Date="01/01/1990"
                                        FontSize="14"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                        VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- SEPARADOR                                          -->
                    <!-- ================================================= -->

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                             Margin="0,4,0,4"/>


                    <!-- ================================================= -->
                    <!-- PERGUNTA DE SEGURANÇA                              -->
                    <!-- ================================================= -->

                    <Label Text="Pergunta de segurança"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,0,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE SEGURANÇA -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Security, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Button x:Name="RecoveryQuestionButton"
                                    Grid.Column="1"
                                    Text="Selecione uma pergunta"
                                    FontSize="14"
                                    Style="{StaticResource SelectorFieldButton}"
                                    BackgroundColor="Transparent"
                                    HeightRequest="46"
                                    Padding="0"
                                    HorizontalOptions="Fill"
                                    Clicked="OnSelectRecoveryQuestionClicked"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- RESPOSTA DE SEGURANÇA                              -->
                    <!-- ================================================= -->

                    <Label Text="Resposta de segurança"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="0,2,0,-4"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{StaticResource BlingPrimary}"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 11"
                            Padding="10,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8"
                              HeightRequest="50">

                            <!-- ÍCONE CHAVE -->

                            <Image
                                Source="{icons:MaterialIconSource Icon=Key, ColorResource=BlingPrimary, IconSize=21}"
                                WidthRequest="21"
                                HeightRequest="21"
                                VerticalOptions="Center"/>

                            <Entry x:Name="RecoveryAnswerEntry"
                                   Grid.Column="1"
                                   Placeholder="Digite sua resposta"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- TERMOS DE USO                                     -->
                    <!-- ================================================= -->

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 11"
                            Padding="9,6"
                            Margin="0,3,0,0">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="7">

                            <CheckBox x:Name="TermsCheck"
                                      VerticalOptions="Center"/>

                            <FlexLayout Grid.Column="1"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        AlignItems="Center"
                                        AlignContent="Center">

                                <Label Text="Li e aceito os "
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       FontSize="12"
                                       VerticalTextAlignment="Center"/>

                                <Label Text="Termos de uso"
                                       TextColor="{StaticResource BlingPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalTextAlignment="Center">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTermsTapped"/>
                                    </Label.GestureRecognizers>

                                </Label>

                                <Label Text=" e a "
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       FontSize="12"
                                       VerticalTextAlignment="Center"/>

                                <Label Text="Política de privacidade"
                                       TextColor="{StaticResource BlingPrimary}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       VerticalTextAlignment="Center">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                                    </Label.GestureRecognizers>

                                </Label>

                            </FlexLayout>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- ERRO                                               -->
                    <!-- ================================================= -->

                    <Label x:Name="ErrorLabel"
                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                           FontSize="12"
                           IsVisible="False"
                           Padding="8,4"
                           HorizontalTextAlignment="Center"/>


                    <!-- ================================================= -->
                    <!-- BOTÕES                                             -->
                    <!-- ================================================= -->

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          Margin="0,4,0,0">

                        <!-- VOLTAR -->

                        <Button Text="Voltar"
                                ImageSource="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingTextDarkLight, IconSize=19}"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                                BorderWidth="1.2"
                                TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                CornerRadius="11"
                                HeightRequest="48"
                                FontSize="13"
                                Clicked="OnCancelClicked"/>


                        <!-- CRIAR CONTA -->

                        <Button Grid.Column="1"
                                Text="Criar conta"
                                ImageSource="{icons:MaterialIconSource Icon=PersonAdd, ColorResource=BlingTextLight, IconSize=19}"
                                BackgroundColor="{StaticResource BlingPrimary}"
                                TextColor="{StaticResource BlingTextLight}"
                                CornerRadius="11"
                                HeightRequest="48"
                                FontSize="13"
                                FontAttributes="Bold"
                                Clicked="OnSubmitClicked"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- LOGIN                                              -->
                    <!-- ================================================= -->

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        Margin="0,3,0,0">

                        <Image
                            Source="{icons:MaterialIconSource Icon=AccountCircle, ColorResource=BlingPrimary, IconSize=16}"
                            WidthRequest="16"
                            HeightRequest="16"
                            VerticalOptions="Center"/>

                        <Label Text="Já tem uma conta?"
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="12"
                               VerticalTextAlignment="Center"/>

                        <Label Text="Faça login"
                               TextColor="{StaticResource BlingPrimary}"
                               FontAttributes="Bold"
                               FontSize="12"
                               VerticalTextAlignment="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </ScrollView>

    </Grid>

</ContentPage>