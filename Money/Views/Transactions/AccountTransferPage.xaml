<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:Money.Helpers"
             x:Class="Money.Views.Transactions.AccountTransferPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="12,8" ColumnDefinitions="44,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}">
            <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}"
                         BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                         WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="12"
                         Clicked="OnCancelClicked"/>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                <Label Text="Transferência entre contas" TextColor="{StaticResource BlingTextLight}"
                       FontSize="18" FontAttributes="Bold"/>
                <Label Text="Movimente saldo sem alterar receitas ou despesas"
                       TextColor="{StaticResource BlingTextLight}" FontSize="10"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,60" Spacing="14" MaximumWidthRequest="700">
                <Border Style="{StaticResource ContentCard}" Padding="16" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Conta de origem" FontAttributes="Bold" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                            <Button x:Name="SourceButton" Text="Selecione a conta de origem"
                                    ImageSource="{icons:MaterialIconSource Icon=AccountBalanceWallet, ColorResource=BlingPrimary, IconSize=20}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                                    BorderWidth="1" CornerRadius="10" HeightRequest="48" Clicked="OnSelectSourceClicked"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Conta de destino" FontAttributes="Bold" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                            <Button x:Name="DestinationButton" Text="Selecione a conta de destino"
                                    ImageSource="{icons:MaterialIconSource Icon=AccountBalance, ColorResource=BlingPrimary, IconSize=20}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                    BorderColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                                    BorderWidth="1" CornerRadius="10" HeightRequest="48" Clicked="OnSelectDestinationClicked"/>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Valor" FontAttributes="Bold" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                <Border x:Name="AmountBorder" Style="{StaticResource SelectionControlContainer}" Padding="10,0">
                                    <Entry x:Name="AmountEntry" Placeholder="R$ 0,00" Keyboard="Numeric" BackgroundColor="Transparent"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Data" FontAttributes="Bold" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                <Border Style="{StaticResource SelectionControlContainer}" Padding="8,0">
                                    <DatePicker x:Name="TransferDatePicker" Format="dd/MM/yyyy" BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Observação (opcional)" FontAttributes="Bold" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                            <Border Style="{StaticResource SelectionControlContainer}" Padding="10,4">
                                <Editor x:Name="NotesEditor" Placeholder="Ex: Reserva de emergência" AutoSize="TextChanges"
                                        MinimumHeightRequest="72" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="ErrorLabel" IsVisible="False" TextColor="#D32F2F" FontSize="12"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Cancelar" BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                            CornerRadius="10" HeightRequest="48" Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1" x:Name="SaveButton" Text="Transferir"
                            ImageSource="{icons:MaterialIconSource Icon=SwapHoriz, ColorResource=BlingTextLight, IconSize=20}"
                            BackgroundColor="{StaticResource BlingPrimary}" TextColor="{StaticResource BlingTextLight}"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Clicked="OnSaveClicked"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
