<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money.Helpers"
             x:Class="Money.Views.Transactions.IncomeListPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" 
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged">

    <Grid RowDefinitions="Auto,*">

        <!-- Cabeçalho Principal -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">

                <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                             WidthRequest="44" HeightRequest="44" 
                             Padding="10" CornerRadius="12" 
                             Aspect="AspectFit" 
                             Clicked="OnBackClicked"
                             VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Receitas e salários" TextColor="{StaticResource BlingTextLight}" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Entradas financeiras registradas" TextColor="{StaticResource BlingTextLight}" FontSize="11"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="16,16,16,100" Spacing="16"
                                     MaximumWidthRequest="1200" HorizontalOptions="Fill">

                    <!-- Card de Filtro por Período -->
                    <Border Style="{StaticResource ContentCard}" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10"
                              RowSpacing="10">

                            <HorizontalStackLayout Grid.ColumnSpan="2" Spacing="8">
                                <mi:MauiIcon Icon="{mi:Material Icon=FilterAlt}" IconSize="20"
                                             IconColor="{StaticResource BlingPrimary}" VerticalOptions="Center"/>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="FILTRO POR PERÍODO" TextColor="{StaticResource BlingPrimary}"
                                           FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Label Text="Selecione o período das receitas" Style="{StaticResource CardCaption}" FontSize="10"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource InputContainer}" Stroke="{StaticResource BlingPrimary}">
                                <Grid ColumnDefinitions="30,*" Padding="8,0">
                                <mi:MauiIcon Icon="{mi:Material Icon=FilterAlt}" IconSize="19"
                                             IconColor="{StaticResource BlingPrimary}" VerticalOptions="Center"/>
                                <Button x:Name="PeriodSelectionButton" Grid.Column="1"
                                        Text="Todos os períodos"
                                        HeightRequest="46"
                                        Padding="12,0"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                        BorderWidth="0"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Fill"
                                        Clicked="OnSelectPeriodClicked"/>
                                </Grid>
                            </Border>

                            <Button Grid.Row="2"
                                    Text="Aplicar filtro"
                                    BackgroundColor="{StaticResource BlingPrimary}"
                                    TextColor="{StaticResource BlingTextLight}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    Clicked="OnFilterClicked"/>

                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Text="Limpar"
                                    BackgroundColor="{StaticResource BlingPrimary}"
                                    TextColor="{StaticResource BlingTextLight}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="10"
                                    Clicked="OnClearFilterClicked"/>
                        </Grid>
                    </Border>

                    <!-- Cards de Métricas e Resumo -->
                    <Grid x:Name="SummaryGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12">

                        <Border Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="TOTAL DE RECEITAS" Style="{StaticResource CardCaption}"/>
                                <Label x:Name="CountLabel" Text="0" Style="{StaticResource MetricValue}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="ValueCard" Grid.Column="1" Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="VALOR RECEBIDO" Style="{StaticResource CardCaption}"/>
                                <Label x:Name="ValueLabel" Text="R$ 0,00" Style="{StaticResource MetricValue}"
                                       TextColor="{StaticResource BlingPrimary}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="AverageCard" Grid.Column="2" Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="MÉDIA POR RECEITA" Style="{StaticResource CardCaption}"/>
                                <Label x:Name="AverageLabel" Text="R$ 0,00" Style="{StaticResource MetricValue}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Tabela / Lista de Receitas -->
                    <Border Style="{StaticResource ContentCard}" Padding="16">
                        <VerticalStackLayout Spacing="12">

                            <!-- Cabeçalho Desktop -->
                            <Grid x:Name="DesktopHeader" ColumnDefinitions="2*,1.3*,1.1*,1.2*,1.1*,Auto"
                                  Padding="12,10" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}">
                                <Label Text="DESCRIÇÃO" Style="{StaticResource TableHeader}"/>
                                <Label Grid.Column="1" Text="CATEGORIA" Style="{StaticResource TableHeader}"/>
                                <Label Grid.Column="2" Text="DATA" Style="{StaticResource TableHeader}"/>
                                <Label Grid.Column="3" Text="CONTA" Style="{StaticResource TableHeader}"/>
                                <Label Grid.Column="4" Text="VALOR" Style="{StaticResource TableHeader}"
                                       HorizontalTextAlignment="End"/>
                                <Label Grid.Column="5" Text="AÇÕES" Style="{StaticResource TableHeader}"/>
                            </Grid>

                            <!-- Lista Desktop -->
                            <CollectionView x:Name="DesktopList">
                                <CollectionView.EmptyView>
                                    <Label Text="Nenhuma receita encontrada." TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           HorizontalTextAlignment="Center" Padding="24"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="2*,1.3*,1.1*,1.2*,1.1*,Auto" Padding="12,12" VerticalOptions="Center">
                                            <Label Text="{Binding Descricao}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Categoria}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalTextAlignment="Center"/>
                                            <Label Grid.Column="2" Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}"
                                                   TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalTextAlignment="Center"/>
                                            <Label Grid.Column="3" Text="{Binding ContaNome}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalTextAlignment="Center"/>
                                            <Label Grid.Column="4" Text="{Binding Valor, StringFormat='R$ {0:N2}'}"
                                                   TextColor="{StaticResource BlingPrimary}" FontAttributes="Bold"
                                                   HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>

                                            <HorizontalStackLayout Grid.Column="5" Spacing="6" Margin="8,0,0,0" VerticalOptions="Center">
                                                <Button Text=""
                                                        ImageSource="{icons:MaterialIconSource Icon=Edit, ColorResource=BlingTextLight, IconSize=20}"
                                                        BackgroundColor="{StaticResource BlingPrimary}"
                                                        TextColor="{StaticResource BlingTextLight}"
                                                        WidthRequest="44" HeightRequest="44" Padding="0"
                                                        CornerRadius="8"
                                                        CommandParameter="{Binding Id}"
                                                        Clicked="OnEditClicked"
                                                        AutomationProperties.Name="Editar receita"/>

                                                <Button Text=""
                                                        ImageSource="{icons:MaterialIconSource Icon=Delete, ColorResource=BlingTextLight, IconSize=20}"
                                                        BackgroundColor="{StaticResource BlingPrimary}"
                                                        TextColor="{StaticResource BlingTextLight}"
                                                        WidthRequest="44" HeightRequest="44" Padding="0"
                                                        CornerRadius="8"
                                                        CommandParameter="{Binding Id}"
                                                        Clicked="OnDeleteClicked"
                                                        AutomationProperties.Name="Excluir receita"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Lista Mobile -->
                            <CollectionView x:Name="MobileList" IsVisible="False">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                                Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" 
                                                StrokeThickness="1"
                                                Padding="14"
                                                Margin="0,0,0,10" 
                                                StrokeShape="RoundRectangle 12">
                                            <Grid RowDefinitions="Auto,Auto"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="12"
                                                  RowSpacing="10">

                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Descricao}" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                                           FontAttributes="Bold" FontSize="14"/>
                                                    <Label Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}"
                                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                                    <Label Text="{Binding Status}" TextColor="{StaticResource BlingPrimary}" FontSize="11" FontAttributes="Bold"/>
                                                </VerticalStackLayout>

                                                <Label Grid.Column="1" Text="{Binding Valor, StringFormat='R$ {0:N2}'}"
                                                       TextColor="{StaticResource BlingPrimary}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       HorizontalTextAlignment="End"/>

                                                <Label Grid.Row="1"
                                                       Text="{Binding ContaNome}"
                                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation"/>

                                                <HorizontalStackLayout Grid.Row="1"
                                                                       Grid.Column="1"
                                                                       Spacing="6"
                                                                       HorizontalOptions="End">
                                                    <Button Text=""
                                                            ImageSource="{icons:MaterialIconSource Icon=Edit, ColorResource=BlingTextLight, IconSize=20}"
                                                            BackgroundColor="{StaticResource BlingPrimary}"
                                                            TextColor="{StaticResource BlingTextLight}"
                                                            WidthRequest="44" HeightRequest="44" Padding="0"
                                                            CornerRadius="8"
                                                            CommandParameter="{Binding Id}"
                                                            Clicked="OnEditClicked"
                                                            AutomationProperties.Name="Editar receita"/>

                                                    <Button Text=""
                                                            ImageSource="{icons:MaterialIconSource Icon=Delete, ColorResource=BlingTextLight, IconSize=20}"
                                                            BackgroundColor="{StaticResource BlingPrimary}"
                                                            TextColor="{StaticResource BlingTextLight}"
                                                            WidthRequest="44" HeightRequest="44" Padding="0"
                                                            CornerRadius="8"
                                                            CommandParameter="{Binding Id}"
                                                            Clicked="OnDeleteClicked"
                                                            AutomationProperties.Name="Excluir receita"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Mensagem de Erro -->
                            <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- FAB padronizado: novo registro -->
            <ImageButton Source="{icons:MaterialIconSource Icon=Add, ColorResource=BlingTextLight, IconSize=28}"
                         BackgroundColor="{StaticResource BlingPrimary}"
                         WidthRequest="58" HeightRequest="58" Padding="15" CornerRadius="29"
                         HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,20"
                         Clicked="OnNewIncomeClicked" AutomationProperties.Name="Nova receita"/>
        </Grid>
    </Grid>
</ContentPage>
