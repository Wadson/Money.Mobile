<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:icons="clr-namespace:Money.Helpers" x:Class="Money.Views.Management.UserEditorPage" Shell.NavBarIsVisible="False"
 BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}">
 <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
  <Grid ColumnDefinitions="44,*" ColumnSpacing="10"><ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingPrimary, IconSize=22}" WidthRequest="44" HeightRequest="44" CornerRadius="12" Clicked="OnBackClicked"/><Label x:Name="TitleLabel" Grid.Column="1" Text="Novo usuário" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center"/></Grid>
  <ScrollView Grid.Row="1"><Border Style="{StaticResource ContentCard}" Padding="16"><VerticalStackLayout Spacing="10">
   <Label Text="NOME / USUÁRIO" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="NameEntry" Placeholder="Nome do usuário" BackgroundColor="Transparent"/></Border>
   <Label Text="E-MAIL" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EmailEntry" Placeholder="seu@email.com" Keyboard="Email" BackgroundColor="Transparent"/></Border>
   <Label Text="DATA DE NASCIMENTO" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><DatePicker x:Name="BirthPicker" Format="dd/MM/yyyy" BackgroundColor="Transparent"/></Border>
   <Label Text="PERGUNTA DE SEGURANÇA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Button x:Name="QuestionButton" Text="Selecione uma pergunta" Style="{StaticResource SelectorFieldButton}" Clicked="OnQuestionClicked"/></Border>
   <Label Text="RESPOSTA DE SEGURANÇA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="AnswerEntry" Placeholder="Obrigatória no cadastro; vazia mantém a atual" BackgroundColor="Transparent"/></Border>
   <Label Text="SENHA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Grid ColumnDefinitions="*,44"><Entry x:Name="PasswordEntry" Placeholder="Obrigatória no cadastro; vazia mantém a atual" IsPassword="True" BackgroundColor="Transparent"/><Button x:Name="PasswordEye" Grid.Column="1" Text="👁" BackgroundColor="Transparent" BorderWidth="0" Clicked="OnPasswordEyeClicked"/></Grid></Border>
   <Label Text="REPETIR SENHA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Grid ColumnDefinitions="*,44"><Entry x:Name="ConfirmationEntry" Placeholder="Repita a senha" IsPassword="True" BackgroundColor="Transparent"/><Button x:Name="ConfirmationEye" Grid.Column="1" Text="👁" BackgroundColor="Transparent" BorderWidth="0" Clicked="OnConfirmationEyeClicked"/></Grid></Border>
   <Button Text="Salvar usuário" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Clicked="OnSaveClicked"/>
  </VerticalStackLayout></Border></ScrollView>
 </Grid>
</ContentPage>
