<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:icons="clr-namespace:Money.Helpers" xmlns:controls="clr-namespace:Money.Controls" xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons" x:Class="Money.Views.Management.UserEditorPage" Shell.NavBarIsVisible="False"
 BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}">
 <Grid RowDefinitions="Auto,*">
  <Grid Padding="16,14" ColumnDefinitions="44,*" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}"><ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingTextLight, IconSize=22}" BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Clicked="OnBackClicked"/><Label x:Name="TitleLabel" Grid.Column="1" Text="Novo usuário" TextColor="{StaticResource BlingTextLight}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/></Grid>
  <ScrollView Grid.Row="1"><VerticalStackLayout Padding="16,14" Spacing="10" MaximumWidthRequest="600">
   <Label Text="Dados do usuário" Style="{StaticResource SectionTitle}"/><Label Text="Cadastro, recuperação de acesso e senha." Style="{StaticResource SectionSubtitle}"/>
   <Border Style="{StaticResource ContentCard}" Padding="16"><VerticalStackLayout Spacing="12">
    <Label Text="NOME / USUÁRIO" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="NameEntry" Placeholder="Nome do usuário" BackgroundColor="Transparent"/></Border>
    <Label Text="E-MAIL" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EmailEntry" Placeholder="seu@email.com" Keyboard="Email" BackgroundColor="Transparent"/></Border>
    <Label Text="DATA DE NASCIMENTO" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><controls:ThemedDateSelector x:Name="BirthPicker" BackgroundColor="Transparent" BorderWidth="0"/></Border>
    <Label Text="PERGUNTA DE SEGURANÇA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Button x:Name="QuestionButton" Text="Selecione uma pergunta" Style="{StaticResource SelectorFieldButton}" Clicked="OnQuestionClicked"/></Border>
    <Label Text="RESPOSTA DE SEGURANÇA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="AnswerEntry" Placeholder="Obrigatória no cadastro; vazia mantém a atual" BackgroundColor="Transparent"/></Border>
    <Label Text="SENHA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Grid ColumnDefinitions="*,44"><Entry x:Name="PasswordEntry" Placeholder="Obrigatória no cadastro; vazia mantém a atual" IsPassword="True" BackgroundColor="Transparent"/><Button x:Name="PasswordEye" Grid.Column="1" ImageSource="{icons:MaterialIconSource Icon=Visibility, ColorResource=BlingPrimary, IconSize=20}" BackgroundColor="Transparent" BorderWidth="0" Clicked="OnPasswordEyeClicked"/></Grid></Border>
    <Label Text="REPETIR SENHA" Style="{StaticResource CardCaption}"/><Border Style="{StaticResource InputContainer}"><Grid ColumnDefinitions="*,44"><Entry x:Name="ConfirmationEntry" Placeholder="Repita a senha" IsPassword="True" BackgroundColor="Transparent"/><Button x:Name="ConfirmationEye" Grid.Column="1" ImageSource="{icons:MaterialIconSource Icon=Visibility, ColorResource=BlingPrimary, IconSize=20}" BackgroundColor="Transparent" BorderWidth="0" Clicked="OnConfirmationEyeClicked"/></Grid></Border>
    <Button Text="Salvar usuário" Style="{StaticResource PrimaryButton}" HeightRequest="46" CornerRadius="12" Margin="0,4,0,0" Clicked="OnSaveClicked"/>
   </VerticalStackLayout></Border></VerticalStackLayout></ScrollView>
 </Grid>
</ContentPage>
