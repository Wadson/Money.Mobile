<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Money.Views.Dialogs.CalendarDateSelectionPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Shell.NavBarIsVisible="False">
    <Grid Padding="18" VerticalOptions="Center">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="18"
                MaximumWidthRequest="520">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Offset="0,3" Opacity="0.18" Radius="10"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" Padding="12,10">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="TitleLabel" Text="Selecione a data" TextColor="{StaticResource BlingTextLight}"
                               FontSize="20" FontAttributes="Bold"/>
                        <Label Text="Toque no dia desejado" TextColor="{StaticResource BlingTextLight}" FontSize="11"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="×" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" BorderColor="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                            BorderWidth="1" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                            FontSize="22" Padding="0" Clicked="OnCancelClicked"/>
                </Grid>
                <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8">
                    <Button Text="‹" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" TextColor="{StaticResource BlingPrimary}"
                            BorderColor="{StaticResource BlingPrimary}" BorderWidth="1" FontSize="25" Padding="0"
                            Clicked="OnPreviousMonthClicked"/>
                    <Label x:Name="MonthLabel" Grid.Column="1" TextColor="{StaticResource BlingPrimary}"
                           FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                    <Button Grid.Column="2" Text="›" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            TextColor="{StaticResource BlingPrimary}" BorderColor="{StaticResource BlingPrimary}"
                            BorderWidth="1" FontSize="25" Padding="0" Clicked="OnNextMonthClicked"/>
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
                    <Label Text="D"/><Label Grid.Column="1" Text="S"/><Label Grid.Column="2" Text="T"/>
                    <Label Grid.Column="3" Text="Q"/><Label Grid.Column="4" Text="Q"/>
                    <Label Grid.Column="5" Text="S"/><Label Grid.Column="6" Text="S"/>
                    <Grid.Resources><Style TargetType="Label"><Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="HorizontalTextAlignment" Value="Center"/></Style></Grid.Resources>
                </Grid>
                <Grid x:Name="DaysGrid" ColumnDefinitions="*,*,*,*,*,*,*"
                      RowDefinitions="44,44,44,44,44,44" ColumnSpacing="4" RowSpacing="4"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Cancelar" BackgroundColor="{StaticResource BlingPrimary}"
                            TextColor="{StaticResource BlingTextLight}" BorderColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}"
                            BorderWidth="1" Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1" Text="Hoje" BackgroundColor="{StaticResource BlingPrimary}"
                            TextColor="{StaticResource BlingTextLight}" Clicked="OnTodayClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

