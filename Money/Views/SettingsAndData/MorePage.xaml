<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money.Helpers"
             x:Class="Money.Views.SettingsAndData.MorePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="GroupTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{StaticResource BlingPrimary}"/>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                             WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="12" Clicked="OnBackClicked"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Mais opções" TextColor="{StaticResource BlingTextLight}" FontSize="20" FontAttributes="Bold"/>
                    <Label Text="Gestão, análises e preferências" TextColor="{StaticResource BlingTextLight}" FontSize="11"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">
                <Label Text="GESTÃO &amp; CADASTROS" Style="{StaticResource GroupTitle}"/>
                <Border Style="{StaticResource ContentCard}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriesTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Category}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Categorias" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnUsersTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Group}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Usuários" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAccountsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=AccountBalanceWallet}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Contas e carteiras" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPaymentReversalTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Restore}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Estorno de pagamentos" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSuppliersTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Storefront}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Fornecedores" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlanningTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Flag}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Metas, lembretes e tags" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTagsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Sell}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Tags de transações" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBudgetsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Savings}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Orçamentos mensais" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="ANÁLISES &amp; RELATÓRIOS" Style="{StaticResource GroupTitle}" Margin="0,4,0,0"/>
                <Border Style="{StaticResource ContentCard}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=CreditCard}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Análise de cartões" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReportsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=RequestQuote}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Relatórios PDF" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMonthlyTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=CalendarMonth}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Visão mensal" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="SISTEMA &amp; PERFIL" Style="{StaticResource GroupTitle}" Margin="0,4,0,0"/>
                <Border Style="{StaticResource ContentCard}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackupTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Backup}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Backup" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSettingsTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Settings}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Configurações e auditoria" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"/>
                        <Border Style="{StaticResource MoreOptionRow}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped"/></Border.GestureRecognizers><Grid ColumnDefinitions="44,*,Auto"><mi:MauiIcon Icon="{mi:Material Icon=Person}" IconSize="23" IconColor="{AppThemeBinding Light={StaticResource BlingPrimary}, Dark={StaticResource BlingTextLight}}"/><Label Grid.Column="1" Text="Perfil" Style="{StaticResource MoreOptionLabel}"/><mi:MauiIcon Grid.Column="2" Icon="{mi:Material Icon=ChevronRight}" IconSize="20" IconColor="{StaticResource BlingPrimary}"/></Grid></Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
