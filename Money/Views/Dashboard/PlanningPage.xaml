<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money.Helpers"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.Views.Dashboard.PlanningPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}" Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" StrokeThickness="0" Padding="16,12">
            <Grid ColumnDefinitions="44,*">
                <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" WidthRequest="44" HeightRequest="44" 
                             Padding="10" CornerRadius="12" Aspect="AspectFit" Clicked="OnBackClicked"/>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <mi:MauiIcon Icon="{mi:Material Icon=Flag}" IconSize="24" IconColor="{StaticResource BlingTextLight}" WidthRequest="28" HeightRequest="28"/>
                        <Label Text="Planejamento" TextColor="{StaticResource BlingTextLight}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Metas, lembretes e tags" TextColor="{StaticResource BlingTextLight}" FontSize="10"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Card: Nova Meta Financeira -->
                <Border Style="{StaticResource ContentCard}" Padding="14" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nova meta financeira" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource BlingPrimary}"/>

                        <!-- Nome da Meta -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="GoalNameEntry" Placeholder="Nome da meta" 
                                   BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>

                        <!-- Objetivos Financas -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Entry x:Name="GoalTargetEntry" Placeholder="Valor objetivo" Keyboard="Numeric" 
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Entry x:Name="GoalCurrentEntry" Placeholder="Valor atual" Keyboard="Numeric" 
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Datas Meta -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <DatePicker x:Name="GoalStartPicker" Format="dd/MM/yyyy" 
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <DatePicker x:Name="GoalDuePicker" Format="dd/MM/yyyy" 
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Prioridade e Categoria -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Picker x:Name="GoalPriorityPicker" Title="Prioridade" 
                                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                        TitleColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Grid>
                                    <Button x:Name="GoalCategoryButton" Text="Sem categoria" BackgroundColor="Transparent"
                                            TextColor="{StaticResource BlingPrimary}" BorderWidth="0" Clicked="OnSelectGoalCategoryClicked"/>
                                    <Picker x:Name="GoalCategoryPicker" IsVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Observações Meta -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,8" HeightRequest="100">
                            <Editor x:Name="GoalNotesEditor" Placeholder="Observações" AutoSize="TextChanges" 
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/>
                        </Border>

                        <Button Text="Salvar meta" ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveGoalClicked"/>
                        <VerticalStackLayout x:Name="GoalsContainer" Spacing="8"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Card: Novo Lembrete -->
                <Border Style="{StaticResource ContentCard}" Padding="14" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Novo lembrete" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource BlingPrimary}"/>

                        <!-- Título Lembrete -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="ReminderTitleEntry" Placeholder="Título" 
                                   BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>

                        <!-- Descrição Lembrete -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,8" HeightRequest="100">
                            <Editor x:Name="ReminderDescriptionEditor" Placeholder="Descrição" AutoSize="TextChanges" 
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"/>
                        </Border>

                        <!-- Data Lembrete -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <DatePicker x:Name="ReminderDatePicker" Format="dd/MM/yyyy" 
                                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" VerticalOptions="Center"/>
                        </Border>

                        <!-- Transação Vinculada -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Entry x:Name="ReminderTransactionEntry" Placeholder="ID da transação vinculada (opcional)"
                                   Keyboard="Numeric" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>

                        <Button Text="Salvar lembrete" ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveReminderClicked"/>
                        <VerticalStackLayout x:Name="RemindersContainer" Spacing="8"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Card: Tags de Transações -->
                <Border Style="{StaticResource ContentCard}" Padding="14" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tags de transações" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource BlingPrimary}"/>

                        <!-- Nome e Cor da Tag -->
                        <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                            <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Entry x:Name="TagNameEntry" Placeholder="Nome da tag" 
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                            </Border>

                            <Border Grid.Column="1" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    Padding="12,2" HeightRequest="46">
                                <Entry x:Name="TagColorEntry" MaxLength="7" 
                                       BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Ícone da Tag -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" 
                                StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                Padding="12,2" HeightRequest="46">
                            <Picker x:Name="TagIconPicker" Title="Ícone da tag" 
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                    TitleColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}" VerticalOptions="Center"/>
                        </Border>

                        <!-- Paleta de Cores Rápida -->
                        <HorizontalStackLayout Spacing="8">
                            <Button BackgroundColor="{StaticResource BlingPrimary}" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0" Clicked="OnTagColorClicked"/>
                            <Button BackgroundColor="{StaticResource BlingPrimary}" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0" Clicked="OnTagColorClicked"/>
                            <Button BackgroundColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0" Clicked="OnTagColorClicked"/>
                            <Button BackgroundColor="{StaticResource BlingPrimary}" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0" Clicked="OnTagColorClicked"/>
                        </HorizontalStackLayout>

                        <Button Text="Adicionar tag" ImageSource="{icons:MaterialIconSource Icon=Sell, ColorResource=BlingTextLight, IconSize=20}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveTagClicked"/>
                        <FlexLayout x:Name="TagsContainer" Wrap="Wrap" Direction="Row"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Mensagem de Erro -->
                <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" Padding="8,4"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
