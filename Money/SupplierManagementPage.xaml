<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             x:Class="Money.SupplierManagementPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Padding="16,14" ColumnDefinitions="44,*,44" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}">
            <ImageButton Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingTextLight, IconSize=24}" BackgroundColor="Transparent" Clicked="OnBackClicked"/>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="0">
                <Label Text="Fornecedores" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                <Label Text="Cadastros e vínculos das despesas" TextColor="#DCEBE6" FontSize="11"/>
            </VerticalStackLayout>
            <ImageButton Grid.Column="2" Source="{icons:MaterialIconSource Icon=AddBusiness, ColorResource=BlingTextLight, IconSize=24}" BackgroundColor="Transparent" Clicked="OnNewClicked"/>
        </Grid>
        <VerticalStackLayout Grid.Row="1" Padding="16,12,16,8" Spacing="8">
            <SearchBar x:Name="SearchEntry" Placeholder="Pesquisar fornecedor" TextChanged="OnFilterChanged"/>
            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="InactiveCheck" Color="{StaticResource BlingPrimary}" CheckedChanged="OnFilterChanged"/>
                <Label Text="Exibir inativos" VerticalTextAlignment="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <RefreshView x:Name="MainRefresh" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="SuppliersList" Margin="16,0,16,16" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" HorizontalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=Storefront}" IconSize="44" IconColor="{StaticResource BlingPrimary}"/>
                        <Label Text="Nenhum fornecedor encontrado" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ContentCard}" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="44,*,32,32" ColumnSpacing="4">
                                <Border BackgroundColor="#E8F5F0" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40">
                                    <mi:MauiIcon Icon="{mi:Material Icon=Storefront}" IconSize="22" IconColor="{StaticResource BlingPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding NomeFornecedor}" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Status}" FontSize="11" TextColor="{StaticResource BlingPrimary}"/>
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="2" Source="{icons:MaterialIconSource Icon=Edit, ColorResource=BlingPrimary, IconSize=16}" BackgroundColor="Transparent" BorderWidth="0" WidthRequest="30" HeightRequest="30" Padding="7" Clicked="OnEditClicked" CommandParameter="{Binding .}"/>
                                <ImageButton Grid.Column="3" Source="{icons:MaterialIconSource Icon=DeleteOutline, ColorResource=BlingPrimary, IconSize=16}" BackgroundColor="Transparent" BorderWidth="0" WidthRequest="30" HeightRequest="30" Padding="7" Clicked="OnDeleteClicked" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
