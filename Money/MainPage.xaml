<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">
    <Grid>
        <RefreshView x:Name="MainContent" Refreshing="OnPullToRefresh" RefreshColor="{StaticResource BlingPrimary}">
            <ScrollView>
                <VerticalStackLayout Padding="18,18,18,105" Spacing="22">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="7" BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}" Padding="16,12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label x:Name="GreetingLabel" Text="Olá!" TextColor="{StaticResource BlingTextLight}" FontSize="16"/>
                            <Label Text="Visão geral" TextColor="{StaticResource BlingTextLight}" FontSize="26" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0"
                                WidthRequest="44" HeightRequest="44" Padding="8" StrokeShape="RoundRectangle 22"
                                AutomationProperties.Name="Alternar tema claro e escuro">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleThemeTapped"/></Border.GestureRecognizers>
                            <mi:MauiIcon x:Name="ThemeIcon" Icon="{mi:Material Icon=DarkMode}" IconSize="24"
                                         IconColor="{StaticResource BlingPrimary}" WidthRequest="28" HeightRequest="28"
                                         HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0"
                                WidthRequest="44" HeightRequest="44" Padding="8" StrokeShape="RoundRectangle 22">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileClicked"/></Border.GestureRecognizers>
                            <mi:MauiIcon Icon="{mi:Material Icon=Person}" IconSize="24" IconColor="{StaticResource BlingPrimary}"
                                         WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0"
                                WidthRequest="44" HeightRequest="44" Padding="8" StrokeShape="RoundRectangle 22">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExitClicked"/></Border.GestureRecognizers>
                            <mi:MauiIcon Icon="{mi:Material Icon=Logout}" IconSize="24" IconColor="{StaticResource BlingPrimary}"
                                         WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Month selector -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" WidthRequest="42" HeightRequest="42"
                                Padding="8" StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPreviousMonthClicked"/></Border.GestureRecognizers>
                            <mi:MauiIcon Icon="{mi:Material Icon=ArrowBack}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                         WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                                StrokeShape="RoundRectangle 14">
                            <Label x:Name="SelectedPeriodLabel" Text="Julho / 2026"
                                   TextColor="{StaticResource BlingPrimary}" FontSize="18" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" WidthRequest="42" HeightRequest="42"
                                Padding="8" StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNextMonthClicked"/></Border.GestureRecognizers>
                            <mi:MauiIcon Icon="{mi:Material Icon=ArrowForward}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                         WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Current month hero -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" Padding="20"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="BALANÇO DO MÊS" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12"
                                   FontAttributes="Bold" CharacterSpacing="1.4"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Receitas / salário" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12"/>
                                    <Label x:Name="MonthlyIncomeLabel" Text="R$ 0,00" TextColor="{StaticResource BlingPrimary}"
                                           FontSize="19" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Total de despesas" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12"/>
                                    <Label x:Name="MonthlyExpensesLabel" Text="R$ 0,00" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           FontSize="19" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="SALDO DO MÊS / SOBRA" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="10"
                                           FontAttributes="Bold"/>
                                    <Label x:Name="MonthlyRemainingLabel" Text="R$ 0,00"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           FontSize="28" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Label x:Name="MonthlyStatusLabel" Grid.Column="1" Text="Saudável"
                                       TextColor="{StaticResource BlingPrimary}" FontSize="11" FontAttributes="Bold"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Comprometimento da renda" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12"/>
                                    <Label x:Name="CommitmentPercentLabel" Grid.Column="1" Text="0%"
                                           TextColor="{StaticResource BlingPrimary}" FontSize="11" FontAttributes="Bold"/>
                                </Grid>
                                <ProgressBar x:Name="CommitmentProgress" HeightRequest="11"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" ProgressColor="{StaticResource BlingPrimary}"/>
                                <Label x:Name="CommitmentTextLabel"
                                       Text="Você comprometeu 0% da sua renda neste mês"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="10"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Quick actions -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="12" Shadow="{StaticResource CardShadow}">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="Ações rápidas" TextColor="{StaticResource BlingPrimary}" FontSize="18" FontAttributes="Bold"/>
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}" HeightRequest="82"
                                    StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickExpenseTapped"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Material Icon=TrendingDown}" IconSize="30" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                                 WidthRequest="38" HeightRequest="38" HorizontalOptions="Center"/>
                                    <Label Text="Despesa" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}"
                                    HeightRequest="82" StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickIncomeTapped"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Material Icon=TrendingUp}" IconSize="30" IconColor="{StaticResource BlingPrimary}"
                                                 WidthRequest="38" HeightRequest="38" HorizontalOptions="Center"/>
                                    <Label Text="Receita" TextColor="{StaticResource BlingPrimary}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}"
                                    HeightRequest="82" StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickPayTapped"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Material Icon=ReceiptLong}" IconSize="30" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                                 WidthRequest="38" HeightRequest="38" HorizontalOptions="Center"/>
                                    <Label Text="Pagar Conta" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1" Shadow="{StaticResource CardShadow}"
                                    HeightRequest="82" StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickCardsTapped"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Material Icon=CreditCard}" IconSize="30" IconColor="{StaticResource BlingPrimary}"
                                                 WidthRequest="38" HeightRequest="38" HorizontalOptions="Center"/>
                                    <Label Text="Cartões" TextColor="{StaticResource BlingPrimary}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1"
                                    Shadow="{StaticResource CardShadow}" HeightRequest="82" StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickAccountsTapped"/></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <mi:MauiIcon Icon="{mi:Material Icon=AccountBalanceWallet}" IconSize="30" IconColor="{StaticResource BlingPrimary}" WidthRequest="38" HeightRequest="38" HorizontalOptions="Center"/>
                                    <Label Text="Contas e Carteiras" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                    </Border>

                    <!-- Upcoming bills -->
                    <VerticalStackLayout Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Contas vencidas" TextColor="{StaticResource BlingPrimary}" FontSize="18" FontAttributes="Bold"/>
                                <Label x:Name="OverdueSummaryLabel" Text="Nenhuma conta vencida"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="14"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Ver todas" BackgroundColor="Transparent"
                                    TextColor="{StaticResource BlingPrimary}" FontSize="13" Padding="8,4"
                                    Clicked="OnAccountsPayableClicked" ImageSource="{icons:MaterialIconSource Icon=ReceiptLong, ColorResource=BlingPrimary, IconSize=18}"/>
                        </Grid>
                        <VerticalStackLayout x:Name="BillsContainer" Spacing="10"/>
                    </VerticalStackLayout>

                    <!-- Budgets -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" Padding="18"
                            StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Orçamentos" TextColor="{StaticResource BlingPrimary}" FontSize="17"
                                           FontAttributes="Bold"/>
                                    <Label Text="Uso por categoria neste mês" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Detalhes" BackgroundColor="Transparent"
                                        TextColor="{StaticResource BlingPrimary}" FontSize="12" Clicked="OnBudgetsClicked" ImageSource="{icons:MaterialIconSource Icon=BarChart, ColorResource=BlingPrimary, IconSize=18}"/>
                            </Grid>
                            <VerticalStackLayout x:Name="BudgetsContainer" Spacing="11"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Recent transactions -->
                    <VerticalStackLayout Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Movimentações recentes" TextColor="{StaticResource BlingPrimary}"
                                       FontSize="18" FontAttributes="Bold"/>
                                <Label Text="Últimos lançamentos confirmados" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="13"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Receitas" BackgroundColor="Transparent"
                                    TextColor="{StaticResource BlingPrimary}" FontSize="10" Clicked="OnIncomeClicked" ImageSource="{icons:MaterialIconSource Icon=TrendingUp, ColorResource=BlingPrimary, IconSize=18}"/>
                        </Grid>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" Padding="8"
                                StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout x:Name="TransactionsContainer" Spacing="0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mini dashboard: composição transparente do balanço mensal -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}"
                            StrokeThickness="1" Padding="16" StrokeShape="RoundRectangle 14" Shadow="{StaticResource CardShadow}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Resumo detalhado do mês" TextColor="{StaticResource BlingPrimary}" FontSize="16" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="9" RowSpacing="9">
                                <mi:MauiIcon Icon="{mi:Material Icon=TrendingUp}" IconSize="19" IconColor="{StaticResource BlingPrimary}"/>
                                <Label Grid.Column="1" Text="Receitas confirmadas / salários" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                <Label x:Name="DetailIncomeLabel" Grid.Column="2" Text="R$ 0,00" TextColor="{StaticResource BlingPrimary}" FontSize="12" FontAttributes="Bold"/>

                                <mi:MauiIcon Grid.Row="1" Icon="{mi:Material Icon=CheckCircle}" IconSize="19" IconColor="{StaticResource BlingPrimary}"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="Despesas pagas" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                <Label x:Name="DetailPaidExpensesLabel" Grid.Row="1" Grid.Column="2" Text="R$ 0,00" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>

                                <mi:MauiIcon Grid.Row="2" Icon="{mi:Material Icon=Schedule}" IconSize="19" IconColor="{StaticResource BlingPrimary}"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="Despesas pendentes (a vencer)" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                <Label x:Name="DetailPendingExpensesLabel" Grid.Row="2" Grid.Column="2" Text="R$ 0,00" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>

                                <mi:MauiIcon Grid.Row="3" Icon="{mi:Material Icon=CreditCard}" IconSize="19" IconColor="{StaticResource BlingPrimary}"/>
                                <Label Grid.Row="3" Grid.Column="1" Text="Gastos em cartão de crédito" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                <Label x:Name="DetailCardExpensesLabel" Grid.Row="3" Grid.Column="2" Text="R$ 0,00" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>

                                <mi:MauiIcon Grid.Row="4" Icon="{mi:Material Icon=AccountBalance}" IconSize="19" IconColor="{StaticResource BlingPrimary}"/>
                                <Label Grid.Row="4" Grid.Column="1" Text="Saldo em contas bancárias (atual)" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                <Label x:Name="DetailBankBalanceLabel" Grid.Row="4" Grid.Column="2" Text="R$ 0,00" TextColor="{StaticResource BlingPrimary}" FontSize="12" FontAttributes="Bold"/>

                                <BoxView Grid.Row="5" Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="Start" Color="{StaticResource BlingPrimary}"/>
                                <Label Grid.Row="5" Grid.Column="1" Text="Resultado líquido do mês" Margin="0,7,0,0" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="12" FontAttributes="Bold"/>
                                <Label x:Name="DetailNetResultLabel" Grid.Row="5" Grid.Column="2" Text="R$ 0,00" Margin="0,7,0,0" TextColor="{StaticResource BlingPrimary}" FontSize="13" FontAttributes="Bold"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Secondary long-term view -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" Padding="18"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Visão patrimonial" TextColor="{StaticResource BlingPrimary}" FontSize="16"
                                   FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Saldo total em contas" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                    <Label x:Name="BalanceLabel" Text="R$ 0,00" TextColor="{StaticResource BlingPrimary}"
                                           FontSize="17" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="Projeção para 90 dias" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                                    <Label x:Name="ForecastLabel" Text="R$ 0,00" TextColor="{StaticResource BlingPrimary}"
                                           FontSize="17" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Fixed bottom navigation -->
        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" Stroke="{AppThemeBinding Light={StaticResource BlingBorderLight}, Dark={StaticResource BlingBorderDark}}" StrokeThickness="1"
                Padding="8,6" HeightRequest="70" VerticalOptions="End"
                Margin="10,0,10,10" ZIndex="20" StrokeShape="RoundRectangle 22"
                Shadow="{StaticResource CardShadow}">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomHomeTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=Home}" IconSize="24" IconColor="{StaticResource BlingPrimary}"
                                     WidthRequest="30" HeightRequest="30" HorizontalOptions="Center"/>
                        <Label Text="Início" TextColor="{StaticResource BlingPrimary}" FontSize="9" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomBillsTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=ReceiptLong}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                     WidthRequest="30" HeightRequest="30" HorizontalOptions="Center"/>
                        <Label Text="Contas" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="{StaticResource BlingPrimary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Margin="2,-5,2,-1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomLaunchTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=Add}" IconSize="28" IconColor="{StaticResource BlingTextLight}"
                                     WidthRequest="34" HeightRequest="34" HorizontalOptions="Center"/>
                        <Label Text="Lançar" TextColor="{StaticResource BlingTextLight}" FontSize="9" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomIncomeTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=AccountBalanceWallet}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                     WidthRequest="30" HeightRequest="30" HorizontalOptions="Center"/>
                        <Label Text="Receitas" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="11"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="4" BackgroundColor="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomMoreTapped"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <mi:MauiIcon Icon="{mi:Material Icon=Menu}" IconSize="24" IconColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                     WidthRequest="30" HeightRequest="30" HorizontalOptions="Center"/>
                        <Label Text="Mais" TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" FontSize="9"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
