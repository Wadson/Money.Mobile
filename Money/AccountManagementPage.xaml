<?xml version="1.0" encoding="utf-8" ?>
<!-- PÁGINA PRINCIPAL: Gerenciamento de Contas (AccountManagementPage) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:icons="clr-namespace:Money"
             xmlns:controls="clr-namespace:Money.Controls"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="Money.AccountManagementPage" 
             BackgroundColor="{AppThemeBinding Light={StaticResource BlingBackgroundLight}, Dark={StaticResource BlingBackgroundDark}}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0" 
              BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}"
              Padding="16,12">

            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="12">
                <!-- Botão Voltar -->
                <ImageButton Grid.Column="0"
                             Source="{icons:MaterialIconSource Icon=ArrowBack, ColorResource=BlingText, IconSize=24}" 
                             BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                             WidthRequest="44" HeightRequest="44" Padding="10" 
                             CornerRadius="12" Aspect="AspectFit"
                             Clicked="OnBackClicked"/>

                <!-- Título -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     Margin="4,0,8,0"
                                     VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="{icons:MaterialIconSource Icon=AccountBalance, ColorResource=BlingTextLight, IconSize=20}"/>
                        <Label Text="Contas" 
                               TextColor="{StaticResource BlingTextLight}" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Bancos, carteiras e investimentos"
                           TextColor="{StaticResource BlingTextLight}" 
                           FontSize="10"
                           Margin="28,0,0,0"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Botão Adicionar -->
                <Button Grid.Column="2" 
                        BackgroundColor="{StaticResource BlingPrimary}" 
                        Padding="10"
                        CornerRadius="12"
                        Clicked="OnNewClicked"
                        ImageSource="{icons:MaterialIconSource Icon=Add, ColorResource=BlingTextLight, IconSize=22}"/>
            </Grid>
        </Grid>

        <!-- CORPO ROLÁVEL -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- CARD DO FORMULÁRIO -->
                <Border x:Name="FormCard" 
                        IsVisible="False" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                        StrokeThickness="1"
                        Padding="16"
                        Margin="0,0,0,8"
                        StrokeShape="RoundRectangle 16">
                    <Border.Stroke>
                        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                    </Border.Stroke>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" Offset="0,4" Radius="12"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <!-- Título do Formulário -->
                        <Label x:Name="FormTitle" 
                               Text="Nova conta" 
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="18"
                               FontAttributes="Bold"
                               Margin="0,0,0,4"/>

                        <!-- Campo Nome -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                StrokeThickness="1.5"
                                Padding="12,4"
                                StrokeShape="RoundRectangle 10">
                            <Border.Stroke>
                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                            </Border.Stroke>
                            <Grid ColumnDefinitions="30,*">
                                <Image Source="{icons:MaterialIconSource Icon=AccountBalanceWallet, ColorResource=BlingText, IconSize=20}"
                                       VerticalOptions="Center"/>
                                <Entry x:Name="NameEntry" 
                                       Grid.Column="1"
                                       Placeholder="Nome da conta"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                       FontSize="14"/>
                            </Grid>
                        </Border>

                        <!-- Grid: Saldo e Tipo -->
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                            <!-- Campo Saldo -->
                            <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    StrokeThickness="1.5"
                                    Padding="12,4"
                                    StrokeShape="RoundRectangle 10">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="30,*">
                                    <Image Source="{icons:MaterialIconSource Icon=Payments, ColorResource=BlingText, IconSize=20}"
                                           VerticalOptions="Center"/>
                                    <Entry x:Name="BalanceEntry" 
                                           Grid.Column="1"
                                           Placeholder="Saldo atual" 
                                           Keyboard="Numeric"
                                           BackgroundColor="Transparent"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                           FontSize="14"/>
                                </Grid>
                            </Border>

                            <!-- Campo Tipo -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="30,*">
                                    <Image x:Name="TypeIconImage" Source="{icons:MaterialIconSource Icon=Category, ColorResource=BlingPrimary, IconSize=20}"
                                           VerticalOptions="Center"
                                           Margin="12,0,0,0"/>
                                    <Button x:Name="TypeSelectionButton" Grid.Column="1"
                                            Text="Selecione o tipo" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                            BorderWidth="0" Padding="4,0,8,0" FontSize="12"
                                            HorizontalOptions="Fill" Clicked="OnSelectTypeClicked"/>
                                    <Picker x:Name="TypePicker" IsVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Grid: Cor e Ícone -->
                        <Grid>

                            <!-- Campo Cor -->
                            <Border IsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    StrokeThickness="1.5"
                                    Padding="12,4"
                                    StrokeShape="RoundRectangle 10">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="30,*,Auto">
                                    <Image Source="{icons:MaterialIconSource Icon=Palette, ColorResource=BlingText, IconSize=20}"
                                           VerticalOptions="Center"/>
                                    <Entry x:Name="ColorEntry" 
                                           Grid.Column="1"
                                           
                                           MaxLength="7"
                                           BackgroundColor="Transparent"
                                           TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource BlingTextMutedLight}, Dark={StaticResource BlingTextMutedDark}}"
                                           FontSize="14"/>
                                    <Border Grid.Column="2"
                                            x:Name="ColorPreviewBorder"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource BlingHeaderDarkLight}, Dark={StaticResource BlingHeaderDarkDark}}"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            Margin="8,0,0,0"
                                            StrokeThickness="2">
                                        <Border.Stroke>
                                            <SolidColorBrush Color="White"/>
                                        </Border.Stroke>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Campo Ícone -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10">
                                <Border.Stroke>
                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"/>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="30,*">
                                    <Image x:Name="SelectedIconImage" Source="{icons:MaterialIconSource Icon=AccountBalanceWallet, ColorResource=BlingPrimary, IconSize=20}"
                                           VerticalOptions="Center"
                                           Margin="12,0,0,0"/>
                                    <Button x:Name="IconSelectionButton" Grid.Column="1"
                                            Text="Selecione o ícone" BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                                            BorderWidth="0" Padding="4,0,8,0" FontSize="12"
                                            HorizontalOptions="Fill" Clicked="OnSelectIconClicked"/>
                                    <Picker x:Name="IconPicker" IsVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Seletor de Cores -->
                        <HorizontalStackLayout x:Name="ColorOptions" IsVisible="False" Spacing="10" Margin="0,4,0,0">
                            <Button BackgroundColor="{StaticResource BlingPrimary}" 
                                    WidthRequest="34" HeightRequest="34" 
                                    CornerRadius="17" Padding="0" 
                                    Clicked="OnColorClicked"/>

                            <Button BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    WidthRequest="34" HeightRequest="34" 
                                    CornerRadius="17" Padding="0" 
                                    Clicked="OnColorClicked"/>

                            <Button BackgroundColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                                    WidthRequest="34" HeightRequest="34" 
                                    CornerRadius="17" Padding="0" 
                                    Clicked="OnColorClicked"/>

                            <Button BackgroundColor="{AppThemeBinding Light={StaticResource BlingCardLight}, Dark={StaticResource BlingCardDark}}" 
                                    WidthRequest="34" HeightRequest="34" 
                                    CornerRadius="17" Padding="0" 
                                    Clicked="OnColorClicked"/>

                            <Button BackgroundColor="{StaticResource BlingPrimary}" 
                                    WidthRequest="34" HeightRequest="34" 
                                    CornerRadius="17" Padding="0" 
                                    Clicked="OnColorClicked"/>
                        </HorizontalStackLayout>

                        <!-- Botões de Ação -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button Text="Cancelar" 
                                    BackgroundColor="{StaticResource BlingPrimary}" 
                                    TextColor="{StaticResource BlingTextLight}" 
                                    Clicked="OnCancelClicked" 
                                    ImageSource="{icons:MaterialIconSource Icon=Close, ColorResource=BlingTextLight, IconSize=20}"
                                    CornerRadius="10"
                                    HeightRequest="44"/>

                            <Button Grid.Column="1" 
                                    Text="Salvar conta" 
                                    ImageSource="{icons:MaterialIconSource Icon=Save, ColorResource=BlingTextLight, IconSize=20}" 
                                    BackgroundColor="{StaticResource BlingPrimary}"
                                    TextColor="{StaticResource BlingTextLight}"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Clicked="OnSaveClicked"/>
                        </Grid>

                        <!-- Mensagem de Erro -->
                        <Label x:Name="ErrorLabel" 
                               IsVisible="False" 
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}" 
                               FontSize="12"
                               Margin="0,4,0,0"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Título da Lista -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="{icons:MaterialIconSource Icon=List, ColorResource=BlingText, IconSize=20}"/>
                        <Label Text="Suas contas" 
                               TextColor="{AppThemeBinding Light={StaticResource BlingTextDarkLight}, Dark={StaticResource BlingTextDarkDark}}"
                               FontSize="18"
                               FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Label x:Name="TotalLabel" 
                           Grid.Column="1" 
                           Text="R$ 0,00" 
                           TextColor="{StaticResource BlingPrimary}" 
                           FontSize="16"
                           FontAttributes="Bold" 
                           VerticalTextAlignment="Center"/>
                </Grid>

                <!-- Container de Contas -->
                <VerticalStackLayout x:Name="AccountsContainer" Spacing="10"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

