<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MauiIcons.Material"><HintPath>$(NuGetPackageRoot)aathifmahir.maui.mauiicons.material/6.0.0/lib/net10.0/MauiIcons.Material.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.0" />
    <PackageReference Include="QuestPDF" Version="2025.12.1" />
    <Compile Include="../../Money/Services/DatabaseService*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../Money/Services/SqliteBackupStore.cs" Link="SqliteBackupStore.cs" />
    <Compile Include="../../Money/Services/AuthService.cs" Link="AuthService.cs" />
    <Compile Include="../../Money/Services/FinancialForecastService.cs" Link="FinancialForecastService.cs" />
    <Compile Include="../../Money/Services/TransactionSchedulePlanner.cs" Link="TransactionSchedulePlanner.cs" />
    <Compile Include="../../Money/Services/ReportPdfService.cs" Link="ReportPdfService.cs" />
    <Compile Include="../../Money/Models/*.cs" Exclude="../../Money/Models/DataCleanupItem.cs" Link="Models/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
